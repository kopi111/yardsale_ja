rules_version = '2';

// Photographs only, of a sensible size, and only by the member they belong
// to: a lot's photos by its seller, an avatar by its member.
service firebase.storage {
  match /b/{bucket}/o {
    function isPhoto() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /listings/{listingId}/{photo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (request.resource == null || isPhoto())
        && firestore.get(/databases/(default)/documents/listings/$(listingId)).data.user_id
             == request.auth.uid;
    }

    match /avatars/{uid}/{photo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (request.resource == null || isPhoto());
    }
  }
}
